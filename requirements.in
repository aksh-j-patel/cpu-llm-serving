# Top-level Python dependencies. The hash-locked file is requirements.txt, generated with:
#   uv pip compile requirements.in --universal --python-version 3.12 --generate-hashes -o requirements.txt
# PyTorch is NOT listed here: it is installed separately from the CPU-only index
# (see TORCH_VERSION in the Dockerfile) to avoid multi-gigabyte CUDA wheels.

# Baseline server and model loading
fastapi
uvicorn
transformers
huggingface_hub

# Load generation and measurement
httpx
psutil
py-spy

# Analysis and plots
numpy
pandas
matplotlib
pyyaml

# Tests and the tiny offline test model
pytest
gguf

